{
  "name": "miximus",
  "dependencies": [
    "boost-asio",
    "boost-container",
    "boost-describe",
    "boost-locale",
    "boost-mp11",
    "boost-program-options",
    "boost-url",
    "boost-uuid",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avdevice",
        "avfilter",
        "avformat",
        "vulkan",
        "dav1d",
        "vpx",
        { "name": "vaapi", "platform": "linux" },
        "swresample",
        "swscale"
      ]
    },
    "freetype",
    "glfw3",
    "glm",
    "nlohmann-json",
    "websocketpp",
    "zlib"
  ]
}
