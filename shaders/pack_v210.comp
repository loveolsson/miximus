#version 450
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, std430) writeonly buffer Output
{
    uint words[];
} destination;

layout(set = 0, binding = 1, rgba16) readonly uniform image2D source;

layout(push_constant) uniform Parameters
{
    uint image_width;
    uint image_height;
    uint row_stride_words;
    uint channel_order;

    // Matrix rows use xyz; w is unused so each row occupies 16 bytes in memory.
    vec4 conversion_row_0;
    vec4 conversion_row_1;
    vec4 conversion_row_2;

    vec4 gamut_row_0;
    vec4 gamut_row_1;
    vec4 gamut_row_2;

    vec4 offset;
} parameters;

vec3 load_encoded_yuv(uint x, uint y)
{
    // Replicate the last active pixel to complete a partial six-pixel packing group.
    vec3 linear_rgb = imageLoad(source, ivec2(min(x, parameters.image_width - 1), y)).rgb;
    vec3 output_rgb = vec3(dot(parameters.gamut_row_0.xyz, linear_rgb),
                           dot(parameters.gamut_row_1.xyz, linear_rgb),
                           dot(parameters.gamut_row_2.xyz, linear_rgb));
    vec3 encoded_rgb = from_linear(output_rgb);

    return vec3(dot(parameters.conversion_row_0.xyz, encoded_rgb),
                dot(parameters.conversion_row_1.xyz, encoded_rgb),
                dot(parameters.conversion_row_2.xyz, encoded_rgb)) + parameters.offset.xyz;
}

uint pack_components(vec3 components)
{
    uvec3 codes = uvec3(round(clamp(components, 0.0, 1.0) * 1023.0));
    return codes.x | (codes.y << 10) | (codes.z << 20);
}

void main()
{
    // One invocation owns an entire six-pixel/four-word group. Each pixel's
    // transfer function and matrix conversion is evaluated once, without the
    // divergent per-word branches that previously recomputed shared samples.
    uvec2 group_position = gl_GlobalInvocationID.xy;
    uint first_word = group_position.x * 4;
    if (first_word >= parameters.row_stride_words || group_position.y >= parameters.image_height) {
        return;
    }

    uint word_index = group_position.y * parameters.row_stride_words + first_word;
    uint first_pixel = group_position.x * 6;
    if (first_pixel >= parameters.image_width) {
        // A caller may provide a row stride that is not a multiple of 16 bytes.
        for (uint i = 0; i < 4 && first_word + i < parameters.row_stride_words; ++i) {
            destination.words[word_index + i] = 0;
        }

        return;
    }

    vec3 a = load_encoded_yuv(first_pixel, group_position.y);
    vec3 b = load_encoded_yuv(first_pixel + 1, group_position.y);
    vec3 c = load_encoded_yuv(first_pixel + 2, group_position.y);
    vec3 d = load_encoded_yuv(first_pixel + 3, group_position.y);
    vec3 e = load_encoded_yuv(first_pixel + 4, group_position.y);
    vec3 f = load_encoded_yuv(first_pixel + 5, group_position.y);

    vec2 ab_chroma = (a.yz + b.yz) * .5;
    vec2 cd_chroma = (c.yz + d.yz) * .5;
    vec2 ef_chroma = (e.yz + f.yz) * .5;

    destination.words[word_index]     = pack_components(vec3(ab_chroma.x, a.x, ab_chroma.y));
    destination.words[word_index + 1] = pack_components(vec3(b.x, cd_chroma.x, c.x));
    destination.words[word_index + 2] = pack_components(vec3(cd_chroma.y, d.x, ef_chroma.x));
    destination.words[word_index + 3] = pack_components(vec3(e.x, ef_chroma.y, f.x));
}
