+class ExternalVideoSource final : public CefExternalVideoSource {
+ public:
+  explicit ExternalVideoSource(
+      scoped_refptr<blink::PushableMediaStreamVideoSource::Broker> broker,
+      blink::MediaStreamTrack* track)
+      : broker_(std::move(broker)),
+        track_(track),
+        source_(track->Component()->Source()) {}
+  ~ExternalVideoSource() override { Stop(); }
+  bool PushFrame(scoped_refptr<media::VideoFrame> frame,
+                 base::TimeTicks capture_time) override {
+    if (!frame || !frame->HasSharedImage() || !source_ ||
+        !broker_->IsRunning()) {
+      return false;
+    }
+    static_cast<InputVideoSource*>(source_->GetPlatformSource())
+        ->SetTransparent(false);
+    static_cast<InputVideoSource*>(source_->GetPlatformSource())
+        ->StampFrame(frame, frame->timestamp());
+    broker_->PushFrame(std::move(frame), capture_time);
+    return true;
+  }
+  v8::Local<v8::Value> GetTrack(v8::Isolate* isolate) override {
+    if (!isolate || !isolate->InContext() || !broker_->IsRunning()) {
+      return {};
+    }
+    auto* script =
+        blink::ScriptState::MaybeFrom(isolate, isolate->GetCurrentContext());
+    auto* context = GetExecutionContext(isolate->GetCurrentContext());
+    if (!script || !script->ContextIsValid() || !context ||
+        context->IsContextDestroyed() || !source_ ||
+        (track_ && track_->GetExecutionContext() != context)) {
+      return {};
+    }
+    if (!track_ || track_->Ended()) {
+      auto* source = source_.Get();
+      auto track = blink::MediaStreamVideoTrack::CreateVideoTrack(
+          static_cast<blink::MediaStreamVideoSource*>(
+              source->GetPlatformSource()),
+          blink::MediaStreamVideoSource::ConstraintsOnceCallback(), true);
+      track_ = blink::MakeGarbageCollected<blink::MediaStreamTrackImpl>(context,
+                                                                        track);
+    }
+    return blink::ToV8Traits<blink::MediaStreamTrack>::ToV8(script,
+                                                            track_.Get());
+  }
+  bool PushTransparentFrame(base::TimeDelta timestamp) override {
+    if (!source_ || !broker_->IsRunning()) {
+      return false;
+    }
+    static_cast<InputVideoSource*>(source_->GetPlatformSource())
+        ->SetTransparent(true, timestamp);
+    return true;
+  }
+  void Stop() override { broker_->StopSource(); }
+  bool IsRunning() override { return broker_->IsRunning(); }
+
+ private:
+  scoped_refptr<blink::PushableMediaStreamVideoSource::Broker> broker_;
+  blink::WeakPersistent<blink::MediaStreamTrack> track_;
+  blink::WeakPersistent<blink::MediaStreamSource> source_;
+};
+}  // namespace
+
+std::unique_ptr<CefExternalVideoSource> CreateExternalVideoTrack(
+    v8::Isolate* isolate,
+    v8::Local<v8::Value>* track,
+    base::OnceClosure stopped) {
+  if (!track) {
+    return nullptr;
+  }
+  *track = {};
+  if (!isolate || !isolate->InContext()) {
+    return nullptr;
+  }
+  auto* script_state =
+      blink::ScriptState::MaybeFrom(isolate, isolate->GetCurrentContext());
+  if (!script_state || !script_state->ContextIsValid()) {
+    return nullptr;
+  }
+  auto* context = GetExecutionContext(isolate->GetCurrentContext());
+  if (!context || context->IsContextDestroyed()) {
+    return nullptr;
+  }
+  auto source = std::make_unique<InputVideoSource>(
+      context->GetTaskRunner(blink::TaskType::kInternalMediaRealTime),
+      stopped ? base::BindPostTaskToCurrentDefault(std::move(stopped))
+              : base::OnceClosure());
+  auto broker = source->GetBroker();
+  auto* platform_source = source.get();
+  const auto id = blink::CreateCanonicalUuidString();
+  blink::MakeGarbageCollected<blink::MediaStreamSource>(
+      id, blink::MediaStreamSource::kTypeVideo, id, false, std::move(source));
+  auto platform_track = blink::MediaStreamVideoTrack::CreateVideoTrack(
+      platform_source, blink::MediaStreamVideoSource::ConstraintsOnceCallback(),
+      true);
+  auto* native_track = blink::MakeGarbageCollected<blink::MediaStreamTrackImpl>(
+      context, platform_track);
+  *track = blink::ToV8Traits<blink::MediaStreamTrack>::ToV8(script_state,
+                                                            native_track);
+  return std::make_unique<ExternalVideoSource>(std::move(broker), native_track);
+}
