--- /dev/null
+++ b/libcef/browser/browser_media_input.cc
@@ -0,0 +1,75 @@
+// Copyright (c) 2026 The Chromium Embedded Framework Authors. All rights
+// reserved. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+#include <fcntl.h>
+
+#include "base/compiler_specific.h"
+#include "base/files/scoped_file.h"
+#include "cef/include/internal/cef_miximus_media_input.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/browser/frame_host_impl.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "ui/gfx/native_pixmap_handle.h"
+
+namespace {
+NO_SANITIZE("cfi-icall")
+void Complete(cef_miximus_media_done_t done,
+              void* user,
+              bool safe,
+              bool delivered) {
+  done(user, safe, delivered);
+}
+}  // namespace
+CEF_EXPORT int cef_miximus_send_media_frame_v2(
+    int browser_id,
+    const char* token,
+    const cef_miximus_media_frame_t* frame,
+    cef_miximus_media_done_t done,
+    void* user) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  if (!token || !*token || !frame || !done || frame->size != sizeof(*frame) ||
+      frame->input >= 8 || !frame->source_generation ||
+      frame->invalidate_only > 1) {
+    return 0;
+  }
+  if (!frame->invalidate_only &&
+      (frame->fd < 0 || !frame->width || !frame->height ||
+       frame->width > 4096 || frame->height > 4096 ||
+       frame->stride < frame->width * 4 ||
+       frame->offset > frame->allocation_bytes ||
+       uint64_t(frame->stride) * frame->height >
+           frame->allocation_bytes - frame->offset)) {
+    return 0;
+  }
+  if (frame->invalidate_only &&
+      (frame->fd != -1 || frame->width || frame->height)) {
+    return 0;
+  }
+  auto browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!browser) {
+    return 0;
+  }
+  auto main = browser->GetMainFrame();
+  if (!main) {
+    return 0;
+  }
+  std::optional<gfx::GpuMemoryBufferHandle> handle;
+  if (!frame->invalidate_only) {
+    base::ScopedFD fd(fcntl(frame->fd, F_DUPFD_CLOEXEC, 0));
+    if (!fd.is_valid()) {
+      return 0;
+    }
+    gfx::NativePixmapHandle pixmap;
+    pixmap.modifier = frame->modifier;
+    pixmap.planes.emplace_back(frame->stride, frame->offset,
+                               frame->allocation_bytes, std::move(fd));
+    handle.emplace(std::move(pixmap));
+  }
+  return static_cast<CefFrameHostImpl*>(main.get())
+      ->SendMediaInput(
+          token, frame->input, frame->source_generation, std::move(handle),
+          gfx::Size(frame->width, frame->height), frame->timestamp_us,
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&Complete, done, user), false, false));
+}
