+// Only lifecycle/refresh policy is custom; Chromium owns track fanout and stop.
+class InputVideoSource final : public blink::PushableMediaStreamVideoSource {
+ public:
+  InputVideoSource(scoped_refptr<base::SingleThreadTaskRunner> runner,
+                   base::OnceClosure stopped)
+      : PushableMediaStreamVideoSource(std::move(runner)),
+        stopped_(std::move(stopped)) {}
+  ~InputVideoSource() override { NotifyStopped(); }
+  void StopSourceImpl() override {
+    PushableMediaStreamVideoSource::StopSourceImpl();
+    transparent_ = false;
+    NotifyStopped();
+  }
+  void RequestRefreshFrame() override {
+    if (transparent_ && GetBroker()->IsRunning()) {
+      const auto now = base::TimeTicks::Now();
+      auto frame = media::VideoFrame::CreateTransparentFrame(gfx::Size(16, 16));
+      StampFrame(frame, transparent_timestamp_ + (now - transparent_started_));
+      GetBroker()->PushFrame(std::move(frame), now);
+    }
+  }
+  void StampFrame(const scoped_refptr<media::VideoFrame>& frame,
+                  base::TimeDelta timestamp) {
+    // Refresh requests use elapsed wall time. Clamp the next program frame as
+    // well, so a refresh racing its delivery cannot move this track backwards.
+    last_timestamp_ =
+        std::max(timestamp, last_timestamp_ + base::Microseconds(1));
+    frame->set_timestamp(last_timestamp_);
+  }
+  void SetTransparent(bool transparent, base::TimeDelta timestamp = {}) {
+    transparent_ = transparent;
+    transparent_timestamp_ = timestamp;
+    transparent_started_ = base::TimeTicks::Now();
+    RequestRefreshFrame();
+  }
+
+ private:
+  void NotifyStopped() {
+    if (stopped_) {
+      std::move(stopped_).Run();
+    }
+  }
+  base::OnceClosure stopped_;
+  bool transparent_ = false;
+  base::TimeDelta transparent_timestamp_;
+  base::TimeTicks transparent_started_;
+  base::TimeDelta last_timestamp_ = base::Microseconds(-1);
+};
