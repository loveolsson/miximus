+// Copyright (c) 2026 The Chromium Embedded Framework Authors. All rights
+// reserved. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+#ifndef CEF_INCLUDE_INTERNAL_CEF_MIXIMUS_MEDIA_INPUT_H_
+#define CEF_INCLUDE_INTERNAL_CEF_MIXIMUS_MEDIA_INPUT_H_
+#include <stdint.h>
+
+#include "cef_export.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+// Private, opt-in Linux prototype ABI. No stock CEF API structures are
+// extended. Metadata only; pixels remain in the GPU allocation. RGBA8 sRGB,
+// top-to-bottom. The caller guarantees producer completion and FOREIGN/GENERAL
+// ownership before sending, then retains the backing allocation until a safe
+// completion callback.
+typedef struct cef_miximus_media_frame_t {
+  uint32_t size;
+  uint32_t input;
+  int fd;
+  uint32_t width;
+  uint32_t height;
+  uint32_t stride;
+  uint64_t offset;
+  uint64_t modifier;
+  uint64_t allocation_bytes;
+  int64_t timestamp_us;
+  uint64_t source_generation;
+  uint32_t invalidate_only;
+} cef_miximus_media_frame_t;
+
+typedef void (*cef_miximus_media_done_t)(void* user,
+                                         int safe_to_reuse,
+                                         int delivered);
+// Renderer main thread, inside OnContextCreated's entered main-frame context.
+// Installs __miximusCreateInputTrack(index); Miximus must capture/remove that
+// temporary property while installing its public asynchronous stream hook.
+CEF_EXPORT int cef_miximus_install_media_inputs_v1(const char* document_token,
+                                                   uint32_t destination_depth);
+// Browser UI thread. Duplicates fd before returning. Zero = rejected before any
+// GPU access; callback will not run. One = accepted; callback runs on UI
+// thread. safe_to_reuse=false includes IPC/context loss and requires
+// quarantine, not reuse.
+CEF_EXPORT int cef_miximus_send_media_frame_v2(
+    int browser_id,
+    const char* document_token,
+    const cef_miximus_media_frame_t* frame,
+    cef_miximus_media_done_t done,
+    void* user);
+#ifdef __cplusplus
+}
+#endif
+#endif  // CEF_INCLUDE_INTERNAL_CEF_MIXIMUS_MEDIA_INPUT_H_
