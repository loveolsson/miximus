+++ b/libcef/renderer/media_input_bridge.cc
@@ -0,0 +1,216 @@
+// Copyright (c) 2026 The Chromium Embedded Framework Authors. All rights
+// reserved. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+#include "cef/libcef/renderer/media_input_bridge.h"
+
+#include "base/task/bind_post_task.h"
+#include "cef/libcef/renderer/thread_util.h"
+#include "cef/libcef/renderer/v8_impl.h"
+#include "components/viz/common/gpu/raster_context_provider.h"
+#include "gpu/GLES2/gl2extchromium.h"
+#include "gpu/command_buffer/client/context_support.h"
+#include "gpu/command_buffer/client/raster_interface.h"
+#include "gpu/command_buffer/client/shared_image_interface.h"
+#include "gpu/command_buffer/common/capabilities.h"
+#include "gpu/command_buffer/common/shared_image_usage.h"
+#include "media/base/video_frame.h"
+#include "third_party/blink/public/platform/platform.h"
+
+CefMediaInputBridge::CefMediaInputBridge(size_t depth) : depth_(depth) {
+  CHECK_GE(depth_, 1u);
+  CHECK_LE(depth_, kMaxDepth);
+}
+CefMediaInputBridge::~CefMediaInputBridge() = default;
+
+CefRefPtr<CefV8Value> CefMediaInputBridge::CreateTrack(
+    size_t input,
+    const std::string& context_token) {
+  CEF_REQUIRE_RT_RETURN(nullptr);
+  if (input >= kInputs || context_token.empty() || context_token.size() > 256 ||
+      failed_) {
+    return nullptr;
+  }
+  if (!context_token_.empty() && context_token != context_token_) {
+    return nullptr;
+  }
+  context_token_ = context_token;
+  auto& entry = inputs_[input];
+  auto* isolate = v8::Isolate::GetCurrent();
+  v8::Local<v8::Value> track;
+  if (entry.source && entry.source->IsRunning()) {
+    track = entry.source->GetTrack(isolate);
+  } else {
+    auto source = blink_glue::CreateExternalVideoTrack(isolate, &track);
+    if (!source) {
+      return nullptr;
+    }
+    entry.source = std::move(source);
+  }
+  if (track.IsEmpty()) {
+    return nullptr;
+  }
+  entry.track =
+      new CefV8ValueImpl(isolate, isolate->GetCurrentContext(), track);
+  return entry.track;
+}
+
+void CefMediaInputBridge::Invalidate() {
+  CEF_REQUIRE_RT();
+  context_token_.clear();
+  for (auto& input : inputs_) {
+    input.source.reset();
+    input.track = nullptr;
+    input.generation = 0;
+  }
+}
+
+void CefMediaInputBridge::AdvanceGeneration(const std::string& token,
+                                            uint32_t input,
+                                            uint64_t generation) {
+  CEF_REQUIRE_RT();
+  if (!failed_ && input < kInputs && token == context_token_ &&
+      generation > inputs_[input].generation) {
+    inputs_[input].generation = generation;
+  }
+}
+
+void CefMediaInputBridge::Submit(const std::string& context_token,
+                                 uint32_t input,
+                                 uint64_t source_generation,
+                                 gfx::GpuMemoryBufferHandle handle,
+                                 const gfx::Size& size,
+                                 int64_t timestamp_us,
+                                 Completion completion) {
+  CEF_REQUIRE_RT();
+  if (failed_ || input >= kInputs || context_token != context_token_ ||
+      context_token.empty() || !inputs_[input].source ||
+      !inputs_[input].source->IsRunning() || size.IsEmpty() ||
+      size.width() > 4096 || size.height() > 4096 ||
+      handle.type != gfx::NATIVE_PIXMAP) {
+    std::move(completion).Run(true, false);
+    return;
+  }
+  if (!source_generation || source_generation < inputs_[input].generation) {
+    std::move(completion).Run(true, false);
+    return;
+  }
+  inputs_[input].generation = source_generation;
+  size_t index = 0;
+  auto& destinations = inputs_[input].destinations;
+  while (index < depth_ && destinations[index].busy) {
+    ++index;
+  }
+  if (index == depth_) {
+    std::move(completion).Run(true, false);
+    return;
+  }
+  if (!context_) {
+    context_ = blink::Platform::Current()->SharedMainThreadContextProvider();
+  }
+  if (!context_ || !context_->ContextCapabilities().sync_query ||
+      context_->RasterInterface()->GetGraphicsResetStatusKHR() != GL_NO_ERROR) {
+    failed_ = true;
+    std::move(completion).Run(true, false);  // No imported access started.
+    return;
+  }
+  auto* sii = context_->SharedImageInterface();
+  auto* ri = context_->RasterInterface();
+  const auto color = gfx::ColorSpace::CreateSRGB();
+  auto& destination = destinations[index];
+  if (!destination.image || destination.image->size() != size) {
+    destination.image.reset();  // Its last release token governs destruction.
+    destination.image =
+        sii->CreateSharedImage({viz::SinglePlaneFormat::kRGBA_8888, size, color,
+                                gpu::SHARED_IMAGE_USAGE_RASTER_READ |
+                                    gpu::SHARED_IMAGE_USAGE_RASTER_WRITE |
+                                    gpu::SHARED_IMAGE_USAGE_GLES2_READ |
+                                    gpu::SHARED_IMAGE_USAGE_DISPLAY_READ,
+                                "CefMediaInputDestination"},
+                               gpu::kNullSurfaceHandle);
+    if (!destination.image) {
+      std::move(completion).Run(true, false);
+      return;
+    }
+    destination.release = destination.image->creation_sync_token();
+  }
+  auto imported = sii->CreateSharedImage(
+      {viz::SinglePlaneFormat::kRGBA_8888, size, color,
+       gpu::SHARED_IMAGE_USAGE_RASTER_READ, "CefMediaInputImport"},
+      std::move(handle));
+  if (!imported) {
+    std::move(completion).Run(true, false);
+    return;
+  }
+  destination.busy = true;
+  auto read =
+      imported->BeginRasterAccess(ri, imported->creation_sync_token(), true);
+  auto write =
+      destination.image->BeginRasterAccess(ri, destination.release, false);
+  ri->CopySharedImage(imported->mailbox(), destination.image->mailbox(), 0, 0,
+                      0, 0, size.width(), size.height());
+  gpu::RasterScopedAccess::EndAccess(std::move(write));
+  auto copied = gpu::RasterScopedAccess::EndAccess(std::move(read));
+  imported->UpdateDestructionSyncToken(copied);
+  destination.image->UpdateDestructionSyncToken(copied);
+  auto frame = media::VideoFrame::WrapSharedImage(
+      media::PIXEL_FORMAT_ABGR, destination.image, copied,
+      base::BindPostTaskToCurrentDefault(
+          base::BindOnce(&CefMediaInputBridge::Released,
+                         base::WrapRefCounted(this), input, index)),
+      gfx::Rect(size), size, base::Microseconds(timestamp_us));
+  CHECK(frame);
+  frame->set_color_space(color);
+  // A SyncToken only orders commands. The completed query, not command receipt,
+  // establishes actual completion before the external Vulkan slot can be
+  // reused.
+  unsigned query = 0;
+  ri->GenQueriesEXT(1, &query);
+  ri->BeginQueryEXT(GL_COMMANDS_COMPLETED_CHROMIUM, query);
+  ri->EndQueryEXT(GL_COMMANDS_COMPLETED_CHROMIUM);
+  context_->ContextSupport()->SignalQuery(
+      query, base::BindOnce(
+                 &CefMediaInputBridge::CopyFinished, base::WrapRefCounted(this),
+                 input, index, query, context_token, source_generation,
+                 std::move(imported), std::move(frame), std::move(completion)));
+  ri->Flush();
+}
+
+void CefMediaInputBridge::CopyFinished(
+    size_t input,
+    size_t /* slot */,
+    unsigned query,
+    std::string context_token,
+    uint64_t source_generation,
+    scoped_refptr<gpu::ClientSharedImage> /* imported */,
+    scoped_refptr<media::VideoFrame> frame,
+    Completion completion) {
+  CEF_REQUIRE_RT();
+  auto* ri = context_->RasterInterface();
+  const bool healthy = ri->GetGraphicsResetStatusKHR() == GL_NO_ERROR;
+  ri->DeleteQueriesEXT(1, &query);
+  if (!healthy) {
+    failed_ = true;
+    std::move(completion).Run(false, false);
+    return;
+  }
+  bool delivered = false;
+  if (context_token == context_token_ &&
+      inputs_[input].generation == source_generation && inputs_[input].source) {
+    delivered = inputs_[input].source->PushFrame(std::move(frame),
+                                                 base::TimeTicks::Now());
+  }
+  std::move(completion).Run(true, delivered);
+}
+
+void CefMediaInputBridge::Released(size_t input,
+                                   size_t slot,
+                                   const gpu::SyncToken& token) {
+  CEF_REQUIRE_RT();
+  auto& destination = inputs_[input].destinations[slot];
+  destination.release = token;
+  destination.image->UpdateDestructionSyncToken(token);
+  // Consumers have released the frame. The next write waits for their release
+  // SyncToken in BeginRasterAccess; no CPU wait or early unsynchronized
+  // overwrite.
+  destination.busy = false;
+}
