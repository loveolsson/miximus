+namespace {
+NO_SANITIZE("cfi-icall")
+void Complete(cef_miximus_media_done_t done,
+              void* user,
+              bool safe,
+              bool delivered) {
+  done(user, safe, delivered);
+}
+}  // namespace
+CEF_EXPORT int cef_miximus_send_media_frame_v3(
+    int browser_id,
+    const char* token,
+    const cef_miximus_media_frame_t* frame,
+    cef_miximus_media_done_t done,
+    void* user) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  if (!token || !*token || !frame || !done || frame->size != sizeof(*frame) ||
+      frame->input >= 8 || !frame->source_generation || frame->operation > 2) {
+    return 0;
+  }
+  if (!frame->operation && (frame->fd < 0 || !frame->width || !frame->height ||
+                            frame->width > 4096 || frame->height > 4096 ||
+                            frame->stride < frame->width * 4 ||
+                            frame->offset > frame->allocation_bytes ||
+                            uint64_t(frame->stride) * frame->height >
+                                frame->allocation_bytes - frame->offset)) {
+    return 0;
+  }
+  if (frame->operation && (frame->fd != -1 || frame->width || frame->height)) {
+    return 0;
+  }
+  auto browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!browser) {
+    return 0;
+  }
+  auto main = browser->GetMainFrame();
+  if (!main) {
+    return 0;
+  }
+  std::optional<gfx::GpuMemoryBufferHandle> handle;
+  if (!frame->operation) {
+    base::ScopedFD fd(fcntl(frame->fd, F_DUPFD_CLOEXEC, 0));
+    if (!fd.is_valid()) {
+      return 0;
+    }
+    gfx::NativePixmapHandle pixmap;
+    pixmap.modifier = frame->modifier;
+    pixmap.planes.emplace_back(frame->stride, frame->offset,
+                               frame->allocation_bytes, std::move(fd));
+    handle.emplace(std::move(pixmap));
+  }
+  return static_cast<CefFrameHostImpl*>(main.get())
+      ->SendMediaInput(
+          token, frame->input, frame->source_generation, std::move(handle),
+          frame->operation == 2 ? gfx::Size(16, 16)
+                                : gfx::Size(frame->width, frame->height),
+          frame->timestamp_us,
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&Complete, done, user), false, false));
+}
