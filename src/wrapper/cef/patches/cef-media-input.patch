+// be found in the LICENSE file.
+#include "cef/include/cef_v8.h"
+#include "cef/include/internal/cef_miximus_media_input.h"
+#include "cef/libcef/renderer/frame_impl.h"
+#include "cef/libcef/renderer/thread_util.h"
+
+namespace {
+class CreateInputTrack final : public CefV8Handler {
+ public:
+  CreateInputTrack(CefRefPtr<CefFrameImpl> frame,
+                   CefRefPtr<CefV8Context> context,
+                   std::string token,
+                   uint32_t depth)
+      : frame_(frame),
+        context_(context),
+        token_(std::move(token)),
+        depth_(depth) {}
+  bool Execute(const CefString&,
+               CefRefPtr<CefV8Value>,
+               const CefV8ValueList& arguments,
+               CefRefPtr<CefV8Value>& result,
+               CefString& exception) override {
+    auto current = CefV8Context::GetCurrentContext();
+    if (!context_->IsValid() || !current || !context_->IsSame(current)) {
+      exception = "Media input document has been revoked";
+      return true;
+    }
+    if (arguments.size() != 1 || !arguments[0]->IsInt() ||
+        arguments[0]->GetIntValue() < 0 || arguments[0]->GetIntValue() >= 8) {
+      exception = "inputIndex must be an integer in [0, 7]";
+      return true;
+    }
+    result = frame_->CreateMediaInputTrack(arguments[0]->GetIntValue(), token_,
+                                           depth_);
+    if (!result) {
+      exception = "Native media input source is unavailable";
+    }
+    return true;
+  }
+
+ private:
+  CefRefPtr<CefFrameImpl> frame_;
+  CefRefPtr<CefV8Context> context_;
+  std::string token_;
+  uint32_t depth_;
+  IMPLEMENT_REFCOUNTING(CreateInputTrack);
+};
+}  // namespace
+
+CEF_EXPORT int cef_miximus_install_media_inputs_v1(const char* document_token,
+                                                   uint32_t destination_depth) {
+  CEF_REQUIRE_RT_RETURN(0);
+  if (!document_token || !*document_token || destination_depth < 1 ||
+      destination_depth > 8) {
+    return 0;
+  }
+  auto context = CefV8Context::GetCurrentContext();
+  if (!context || !context->IsValid() || !context->GetFrame()->IsMain()) {
+    return 0;
+  }
+  return context->GetGlobal()->SetValue(
+      "__miximusCreateInputTrack",
+      CefV8Value::CreateFunction(
+          "createInputTrack",
+          new CreateInputTrack(
+              static_cast<CefFrameImpl*>(context->GetFrame().get()), context,
+              document_token, destination_depth)),
+      V8_PROPERTY_ATTRIBUTE_DONTENUM);
+}
