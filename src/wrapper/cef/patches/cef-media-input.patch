+namespace viz {
+class RasterContextProvider;
+}
+
+// Renderer-main-thread bridge. Outstanding VideoFrames and copy callbacks
+// retain this object after navigation. No source buffer is acknowledged safe on
+// context loss. Destination capacity includes frames retained by consumers
+// across resize.
+class CefMediaInputBridge : public base::RefCounted<CefMediaInputBridge> {
+ public:
+  static constexpr size_t kInputs = 8;
+  static constexpr size_t kMaxDepth = 8;
+  using Completion =
+      base::OnceCallback<void(bool safe_to_reuse, bool delivered)>;
+  using Activity =
+      base::RepeatingCallback<void(const std::string&, uint32_t, bool, bool)>;
+  using Failure =
+      base::RepeatingCallback<void(const std::string&, const std::string&)>;
+  explicit CefMediaInputBridge(int browser_id,
+                               size_t depth,
+                               Activity activity,
+                               Failure failure);
+  bool SetTransparent(const std::string& token,
+                      uint32_t input,
+                      uint64_t generation,
+                      int64_t timestamp_us);
+  CefRefPtr<CefV8Value> CreateTrack(size_t input,
+                                    const std::string& context_token);
+  void Invalidate();
+  void AdvanceGeneration(const std::string& context_token,
+                         uint32_t input,
+                         uint64_t generation);
+  void Submit(const std::string& context_token,
+              uint32_t input,
+              uint64_t source_generation,
+              gfx::GpuMemoryBufferHandle handle,
+              const gfx::Size& size,
+              int64_t timestamp_us,
+              Completion completion);
+
+ private:
+  friend class base::RefCounted<CefMediaInputBridge>;
+  ~CefMediaInputBridge();
+  struct Destination {
+    scoped_refptr<gpu::ClientSharedImage> image;
+    gpu::SyncToken release;
+    bool busy = false;
+  };
+  struct Input {
+    uint64_t generation = 0;
+    uint64_t activation = 0;
+    bool active = false;
+    bool transparent = false;
+    std::unique_ptr<blink_glue::CefExternalVideoSource> source;
+    std::array<Destination, kMaxDepth> destinations;
+  };
+  void CopyFinished(size_t input,
+                    unsigned query,
+                    std::string context_token,
+                    uint64_t source_generation,
+                    scoped_refptr<gpu::ClientSharedImage> imported,
+                    scoped_refptr<media::VideoFrame> frame,
+                    Completion completion);
+  void Released(size_t input, size_t slot, const gpu::SyncToken& token);
+  void SourceStopped(size_t input, uint64_t activation);
+  void ReleaseUnused(size_t input);
+  void NotifyInactive(size_t input);
+  void Fail(const std::string& error);
+  const int browser_id_;
+  const size_t depth_;
+  std::string context_token_;
+  std::string retired_token_;
+  std::array<Input, kInputs> inputs_;
+  scoped_refptr<viz::RasterContextProvider> context_;
+  bool failed_ = false;
+  Activity activity_;
+  Failure failure_;
+  base::WeakPtrFactory<CefMediaInputBridge> weak_factory_{this};
+};
+#endif  // CEF_LIBCEF_RENDERER_MEDIA_INPUT_BRIDGE_H_
