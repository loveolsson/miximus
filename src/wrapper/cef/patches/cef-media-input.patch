+#define CEF_LIBCEF_RENDERER_EXTERNAL_VIDEO_SOURCE_H_
+
+#include <memory>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/time/time.h"
+#include "third_party/blink/public/platform/web_common.h"
+#include "v8/include/v8-local-handle.h"
+
+namespace media {
+class VideoFrame;
+}
+namespace v8 {
+class Isolate;
+class Value;
+}  // namespace v8
+
+namespace blink_glue {
+// Native frames enter Chromium's existing push source and normal track
+// pipeline. The transport must bound outstanding frame allocations and preserve
+// release sync tokens. A true PushFrame result is admission, never GPU
+// retirement.
+class BLINK_EXPORT CefExternalVideoSource {
+ public:
+  virtual ~CefExternalVideoSource() = default;
+  virtual bool PushFrame(scoped_refptr<media::VideoFrame> frame,
+                         base::TimeTicks capture_time) = 0;
+  // Return the live cached track or recreate a stopped track on this source.
+  virtual v8::Local<v8::Value> GetTrack(v8::Isolate* isolate) = 0;
+  virtual void Stop() = 0;
+  virtual bool IsRunning() = 0;
+};
+
+// Main renderer thread, entered live Blink context, active HandleScope.
+// Returns a real live MediaStreamTrack without waiting for its first frame.
+// The caller retains |track| in its document and destroys the returned source
+// on context release. Stop/destruction stops the source, including cloned
+// tracks. Frames are delivered natively; no per-frame JavaScript callback is
+// installed.
+BLINK_EXPORT std::unique_ptr<CefExternalVideoSource> CreateExternalVideoTrack(
+    v8::Isolate* isolate,
+    v8::Local<v8::Value>* track);
+}  // namespace blink_glue
+#endif  // CEF_LIBCEF_RENDERER_EXTERNAL_VIDEO_SOURCE_H_
