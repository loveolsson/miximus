+namespace {
+void NotifyMediaInputRetired(int browser_id,
+                             const std::string& token,
+                             uint32_t input) {
+  CEF_REQUIRE_UIT();
+  auto browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!browser || !browser->GetClient() || !browser->GetMainFrame()) {
+    return;
+  }
+  auto message = CefProcessMessage::Create("miximus.media-input.retired.v1");
+  auto args = message->GetArgumentList();
+  args->SetString(0, token);
+  args->SetInt(1, input);
+  browser->GetClient()->OnProcessMessageReceived(
+      browser, browser->GetMainFrame(), PID_RENDERER, message);
+}
+
+// A process swap may fast-shutdown the renderer before its frame-release
+// callbacks run. Observe that terminal lifetime separately from frame IPC.
+// This retires Chromium destination accounting, NEVER native DMA read leases.
+class MediaInputProcesses final : public base::SupportsUserData::Data,
+                                  public content::RenderProcessHostObserver {
+ public:
+  explicit MediaInputProcesses(content::RenderProcessHost* host) {
+    host->AddObserver(this);
+  }
+  void Update(int browser_id,
+              const std::string& token,
+              uint32_t input,
+              bool active) {
+    const auto key = std::make_pair(browser_id, token);
+    if (active) {
+      inputs_[key] |= 1u << input;
+    } else {
+      auto it = inputs_.find(key);
+      if (it != inputs_.end()) {
+        it->second &= ~(1u << input);
+        if (!it->second) {
+          inputs_.erase(it);
+        }
+      }
+      NotifyMediaInputRetired(browser_id, token, input);
+    }
+  }
+  void RenderProcessExited(
+      content::RenderProcessHost*,
+      const content::ChildProcessTerminationInfo&) override {
+    Retire();
+  }
+  void RenderProcessHostDestroyed(content::RenderProcessHost* host) override {
+    Retire();
+    host->RemoveObserver(this);
+  }
+
+ private:
+  void Retire() {
+    auto inputs = std::exchange(inputs_, {});
+    for (const auto& [key, mask] : inputs) {
+      for (uint32_t input = 0; input < 8; ++input) {
+        if (mask & (1u << input)) {
+          NotifyMediaInputRetired(key.first, key.second, input);
+        }
+      }
+    }
+  }
+  std::map<std::pair<int, std::string>, uint32_t> inputs_;
+};
+
+void UpdateMediaInputProcess(content::ChildProcessId process_id,
+                             int browser_id,
+                             std::string token,
+                             uint32_t input,
+                             bool active) {
+  CEF_REQUIRE_UIT();
+  auto* host = content::RenderProcessHost::FromID(process_id);
+  if (!host) {
+    return;
+  }
+  static const int kMediaInputsKey = 0;
+  auto* observer =
+      static_cast<MediaInputProcesses*>(host->GetUserData(&kMediaInputsKey));
+  if (!observer) {
+    auto owner = std::make_unique<MediaInputProcesses>(host);
+    observer = owner.get();
+    host->SetUserData(&kMediaInputsKey, std::move(owner));
+  }
+  observer->Update(browser_id, token, input, active);
+}
+}  // namespace
+
+void CefBrowserManager::MediaInputActivity(int32_t browser_id,
+                                           const std::string& document_token,
+                                           uint32_t input,
+                                           bool active) {
+  if (input >= 8 || document_token.size() > 256) {
+    return;
+  }
+  // The document token is CEF's frame identifier followed by a context serial.
+  // Use the canonical parser: the identifier's process ID is hexadecimal.
+  const auto separator = document_token.find(':');
+  if (separator == std::string::npos) {
+    return;
+  }
+  const auto frame_token =
+      frame_util::ParseFrameIdentifier(document_token.substr(0, separator));
+  if (!frame_token ||
+      frame_token->child_id != render_process_id_.GetUnsafeValue()) {
+    return;
+  }
+  CEF_POST_TASK(TID_UI,
+                base::BindOnce(&UpdateMediaInputProcess, render_process_id_,
+                               browser_id, document_token, input, active));
+}
