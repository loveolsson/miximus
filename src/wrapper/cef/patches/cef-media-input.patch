+// be found in the LICENSE file.
+#ifndef CEF_INCLUDE_INTERNAL_CEF_MIXIMUS_MEDIA_INPUT_H_
+#define CEF_INCLUDE_INTERNAL_CEF_MIXIMUS_MEDIA_INPUT_H_
+#include <stdint.h>
+
+#include "cef_export.h"
+#ifdef __cplusplus
+extern "C" {
