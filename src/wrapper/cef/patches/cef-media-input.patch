+bool CefFrameHostImpl::SendMediaInput(
+    const std::string& token,
+    uint32_t input,
+    uint64_t source_generation,
+    std::optional<gfx::GpuMemoryBufferHandle> handle,
+    const gfx::Size& size,
+    int64_t timestamp_us,
+    cef::mojom::RenderFrame::SubmitMediaInputCallback callback) {
+  CEF_REQUIRE_UIT_RETURN(false);
+  // Never join the general unbounded pre-attachment command queue.
+  if (!IsMain() || !render_frame_host_ || !render_frame_.is_bound()) {
+    std::move(callback).Run(true, false);
+    return true;
+  }
+  render_frame_->SubmitMediaInput(token, input, source_generation,
+                                  std::move(handle), size, timestamp_us,
+                                  std::move(callback));
+  return true;
+}
