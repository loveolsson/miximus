+CefRefPtr<CefV8Value> CefFrameImpl::CreateMediaInputTrack(
+    uint32_t input,
+    const std::string& token,
+    uint32_t destination_depth) {
+  CEF_REQUIRE_RT_RETURN(nullptr);
+  if (!IsMain() || !frame_) {
+    return nullptr;
+  }
+  if (!media_inputs_) {
+    media_inputs_ = base::MakeRefCounted<CefMediaInputBridge>(
+        browser_->GetIdentifier(), destination_depth,
+        base::BindRepeating(
+            [](base::WeakPtr<CefFrameImpl> frame, const std::string& token,
+               uint32_t input, bool active, bool drained) {
+              if (!frame) {
+                return;
+              }
+              auto message =
+                  CefProcessMessage::Create("miximus.media-input.activity.v1");
+              auto args = message->GetArgumentList();
+              args->SetString(0, token);
+              args->SetInt(1, input);
+              args->SetBool(2, active);
+              args->SetBool(3, drained);
+              frame->SendProcessMessage(PID_BROWSER, message);
+            },
+            weak_ptr_factory_.GetWeakPtr()),
+        base::BindRepeating(
+            [](base::WeakPtr<CefFrameImpl> frame, const std::string& token,
+               const std::string& error) {
+              if (!frame) {
+                return;
+              }
+              auto message =
+                  CefProcessMessage::Create("miximus.media-input.failure.v1");
+              auto args = message->GetArgumentList();
+              args->SetString(0, token);
+              args->SetString(1, error);
+              frame->SendProcessMessage(PID_BROWSER, message);
+            },
+            weak_ptr_factory_.GetWeakPtr()));
+  }
+  return media_inputs_->CreateTrack(input, token);
+}
+
+void CefFrameImpl::SubmitMediaInput(
+    const std::string& token,
+    uint32_t input,
+    uint64_t source_generation,
+    std::optional<gfx::GpuMemoryBufferHandle> handle,
+    const gfx::Size& size,
+    int64_t timestamp_us,
+    SubmitMediaInputCallback callback) {
+  CEF_REQUIRE_RT();
+  if (!media_inputs_ || !IsMain() || !frame_) {
+    std::move(callback).Run(true, false);
+    return;
+  }
+  if (!handle) {
+    if (size == gfx::Size(16, 16)) {
+      std::move(callback).Run(
+          true, media_inputs_->SetTransparent(token, input, source_generation,
+                                              timestamp_us));
+    } else {
+      media_inputs_->AdvanceGeneration(token, input, source_generation);
+      std::move(callback).Run(true, false);
+    }
+    return;
+  }
+  media_inputs_->Submit(token, input, source_generation, std::move(*handle),
+                        size, timestamp_us, std::move(callback));
+}
