+#include "third_party/blink/renderer/bindings/modules/v8/v8_media_stream_track_state.h"
+#include "third_party/blink/renderer/modules/mediastream/media_stream_track.h"
+#include "third_party/blink/renderer/platform/testing/io_task_runner_testing_platform_support.h"
+#include "third_party/blink/renderer/platform/testing/task_environment.h"
+#include "third_party/blink/renderer/platform/wtf/cross_thread_functional.h"
+
+namespace blink_glue {
+namespace {
+
+class ExternalVideoSourceTest : public testing::Test {
+ protected:
+  blink::test::TaskEnvironment task_environment_;
+  blink::ScopedTestingPlatformSupport<blink::IOTaskRunnerTestingPlatformSupport>
+      platform_;
+};
+
+class FrameSink final : public blink::MediaStreamVideoSink {
+ public:
+  FrameSink(scoped_refptr<media::VideoFrame>* received, base::OnceClosure done)
+      : received_(received), done_(std::move(done)) {}
+  void Connect(const blink::WebMediaStreamTrack& track) {
+    ConnectToTrack(
+        track,
+        ConvertToBaseRepeatingCallback(blink::CrossThreadBindRepeating(
+            &FrameSink::OnFrame, blink::CrossThreadUnretained(this))),
+        IsSecure::kYes, UsesAlpha::kDefault);
+  }
+  void Disconnect() { DisconnectFromTrack(); }
+
+ private:
+  void OnFrame(scoped_refptr<media::VideoFrame> frame, base::TimeTicks) {
+    *received_ = std::move(frame);
+    std::move(done_).Run();
+  }
+  raw_ptr<scoped_refptr<media::VideoFrame>> received_;
+  base::OnceClosure done_;
+};
+
+scoped_refptr<media::VideoFrame> GpuFrame() {
+  return media::VideoFrame::WrapSharedImage(
+      media::PIXEL_FORMAT_ABGR, gpu::ClientSharedImage::CreateForTesting(),
+      gpu::SyncToken(), media::VideoFrame::ReleaseMailboxCB(),
+      gfx::Rect(64, 64), gfx::Size(64, 64), base::Microseconds(1234));
+}
+
+TEST_F(ExternalVideoSourceTest, EightDisconnectedTracksAreLiveAndIndependent) {
+  blink::V8TestingScope scope;
+  std::vector<std::unique_ptr<CefExternalVideoSource>> sources;
+  std::vector<blink::MediaStreamTrack*> tracks;
+  for (int input = 0; input < 8; ++input) {
+    v8::Local<v8::Value> value;
+    auto source = CreateExternalVideoTrack(scope.GetIsolate(), &value);
+    ASSERT_TRUE(source);
+    ASSERT_FALSE(value.IsEmpty());
+    auto* track =
+        blink::V8MediaStreamTrack::ToWrappable(scope.GetIsolate(), value);
+    ASSERT_TRUE(track);
+    EXPECT_EQ(track->readyState().AsEnum(),
+              blink::V8MediaStreamTrackState::Enum::kLive);
+    tracks.push_back(track);
+    sources.push_back(std::move(source));
+  }
+  sources[0]->Stop();
+  EXPECT_EQ(tracks[0]->readyState().AsEnum(),
+            blink::V8MediaStreamTrackState::Enum::kEnded);
+  for (size_t input = 1; input < tracks.size(); ++input) {
+    EXPECT_EQ(tracks[input]->readyState().AsEnum(),
+              blink::V8MediaStreamTrackState::Enum::kLive);
+    EXPECT_NE(tracks[0]->id(), tracks[input]->id());
+  }
+}
+
+TEST_F(ExternalVideoSourceTest, NativeGpuFrameReachesNormalTrackSinkUnchanged) {
+  blink::V8TestingScope scope;
+  v8::Local<v8::Value> value;
+  auto source = CreateExternalVideoTrack(scope.GetIsolate(), &value);
+  ASSERT_TRUE(source);
+  scoped_refptr<media::VideoFrame> received;
+  base::RunLoop loop;
+  FrameSink sink(&received,
+                 base::BindPostTaskToCurrentDefault(loop.QuitClosure()));
+  sink.Connect(
+      blink::WebDOMMediaStreamTrack::FromV8Value(scope.GetIsolate(), value)
+          .Component());
+  auto frame = GpuFrame();
+  ASSERT_TRUE(frame);
+  ASSERT_TRUE(source->PushFrame(frame, base::TimeTicks::Now()));
+  loop.Run();
+  EXPECT_EQ(received, frame);
+  EXPECT_TRUE(received->HasSharedImage());
+  EXPECT_EQ(received->timestamp(), base::Microseconds(1234));
+  sink.Disconnect();
+}
+
+TEST_F(ExternalVideoSourceTest, StopAndDestructionUseExistingTrackLifecycle) {
+  blink::V8TestingScope scope;
+  v8::Local<v8::Value> value;
+  auto source = CreateExternalVideoTrack(scope.GetIsolate(), &value);
+  ASSERT_TRUE(source);
+  auto* track =
+      blink::V8MediaStreamTrack::ToWrappable(scope.GetIsolate(), value);
+  auto* clone = track->clone(scope.GetExecutionContext());
+  ASSERT_TRUE(clone);
+  track->stopTrack(scope.GetExecutionContext());
+  EXPECT_EQ(clone->readyState().AsEnum(),
+            blink::V8MediaStreamTrackState::Enum::kLive);
+  EXPECT_FALSE(source->PushFrame(nullptr, base::TimeTicks::Now()));
+  EXPECT_FALSE(
+      source->PushFrame(media::VideoFrame::CreateBlackFrame(gfx::Size(16, 16)),
+                        base::TimeTicks::Now()));
+  source.reset();
+  EXPECT_EQ(clone->readyState().AsEnum(),
+            blink::V8MediaStreamTrackState::Enum::kEnded);
+}
+
+TEST_F(ExternalVideoSourceTest, ReacquireStoppedTrackPreservesLiveClone) {
+  blink::V8TestingScope scope;
+  v8::Local<v8::Value> value;
+  auto source = CreateExternalVideoTrack(scope.GetIsolate(), &value);
+  ASSERT_TRUE(source);
+  auto* original =
+      blink::V8MediaStreamTrack::ToWrappable(scope.GetIsolate(), value);
+  auto* clone = original->clone(scope.GetExecutionContext());
+  original->stopTrack(scope.GetExecutionContext());
+  auto replacement_value = source->GetTrack(scope.GetIsolate());
+  ASSERT_FALSE(replacement_value.IsEmpty());
+  auto* replacement = blink::V8MediaStreamTrack::ToWrappable(scope.GetIsolate(),
+                                                             replacement_value);
+  EXPECT_NE(replacement, original);
+  EXPECT_FALSE(replacement->Ended());
+  EXPECT_FALSE(clone->Ended());
+  EXPECT_EQ(replacement->Component()->Source(), clone->Component()->Source());
+  EXPECT_EQ(blink::V8MediaStreamTrack::ToWrappable(
+                scope.GetIsolate(), source->GetTrack(scope.GetIsolate())),
+            replacement);
+  source.reset();
+  EXPECT_TRUE(replacement->Ended());
+  EXPECT_TRUE(clone->Ended());
+}
+
+TEST_F(ExternalVideoSourceTest, MissingContextIsRejected) {
+  v8::Local<v8::Value> value;
+  EXPECT_FALSE(CreateExternalVideoTrack(nullptr, &value));
+  EXPECT_TRUE(value.IsEmpty());
+  EXPECT_FALSE(CreateExternalVideoTrack(nullptr, nullptr));
+}
+
+}  // namespace
+}  // namespace blink_glue
