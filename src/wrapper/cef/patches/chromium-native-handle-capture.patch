@@ -874,7 +892,9 @@ class FrameSinkVideoCapturerTest
 
   bool IsUsingGpuMemoryBuffer() {
     return buffer_format_preference_ ==
-           mojom::BufferFormatPreference::kPreferMappableSharedImage;
+               mojom::BufferFormatPreference::kPreferMappableSharedImage ||
