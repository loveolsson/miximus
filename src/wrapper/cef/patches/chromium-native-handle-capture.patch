+  const bool should_capture_texture_results =
+      prefer_shared_image && (pixel_format_ == media::PIXEL_FORMAT_NV12 ||
+                              pixel_format_ == media::PIXEL_FORMAT_ARGB ||
+                              pixel_format_ == media::PIXEL_FORMAT_RGBAF16);
 
