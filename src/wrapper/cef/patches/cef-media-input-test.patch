diff --git a/cef/libcef/renderer/external_video_source_test.cc b/cef/libcef/renderer/external_video_source_test.cc
--- a/cef/libcef/renderer/external_video_source_test.cc
+++ b/cef/libcef/renderer/external_video_source_test.cc
